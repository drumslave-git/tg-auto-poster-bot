# Server
PORT=3000

# Protects the dashboard API with a shared secret. Strongly recommended when
# the dashboard is reachable from anything other than localhost.
DASHBOARD_PASSWORD=

# Optional bootstrap values — only used the first time the database is created.
# Everything below can be changed later from the dashboard.
BOT_TOKEN=

# Comma-separated Telegram user IDs. Admins may do everything; managers may only
# add posts to the queue. (ADMIN_ID, the older single-value name, still works.)
ADMIN_IDS=
MANAGER_IDS=

TZ_NAME=UTC

# Links are turned into posts with yt-dlp and ffmpeg, both taken from PATH and
# shown in the dashboard under "Media tools". There is nothing to configure:
# the Docker image ships them, and yt-dlp keeps itself up to date.
